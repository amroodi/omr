# Nginx reverse proxy — one TLS front door for both apps.
#   /api/  -> NestJS API on 127.0.0.1:17421  (keeps the /api/v1 prefix)
#   /      -> Next.js web on 127.0.0.1:29318
# Both apps bind to 127.0.0.1 on non-generic ports; only Nginx (80/443) is public.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/omr
#   sudo ln -s /etc/nginx/sites-available/omr /etc/nginx/sites-enabled/omr
#   sudo nginx -t && sudo systemctl reload nginx
# Then add TLS automatically (edits this file in place, adds the 443 block + HTTP->HTTPS redirect):
#   sudo certbot --nginx -d panel.damuon.com

server {
    listen 80;
    listen [::]:80;
    server_name panel.damuon.com;   # <-- your domain

    # Document uploads are up to 15 MB; allow headroom.
    client_max_body_size 20m;

    # API: everything under /api/ goes to NestJS (its global prefix is /api/v1).
    location /api/ {
        proxy_pass http://127.0.0.1:17421;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Web: everything else goes to Next.js.
    location / {
        proxy_pass http://127.0.0.1:29318;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
