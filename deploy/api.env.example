# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION environment for the API (apps/api).
# Copy to the server as /etc/omr/api.env  (chmod 600, owned by the omr user).
# NEVER commit the filled-in version. Generate every secret fresh on the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Points at the Postgres container from deploy/postgres.compose.yml (localhost, port 15987).
# Use a strong password and URL-encode any @ : / ? # % & characters in it.
DATABASE_URL="postgresql://omr:CHANGE_ME_DB_PASSWORD@127.0.0.1:15987/omr_damuon?schema=public"

# ── Server ──────────────────────────────────────────────────────────────────
# Non-generic port, bound to localhost (the API is only reached via Nginx).
PORT=17421
HOST=127.0.0.1
NODE_ENV=production
# API processes on this server (Node cluster): "auto" = one per CPU core, or a number. Default 1.
# Each process keeps its own database connection pool: with N processes, add
# `&connection_limit=10` (or so) to DATABASE_URL so N × limit stays under Postgres' max_connections
# (100 by default). Rate limits are shared through Postgres, so they hold across processes.
API_WORKERS=1
# ── Valkey / Redis (optional) ─────────────────────────────────────────────────────
# Recommended server: Valkey (the Linux Foundation's open-source fork of Redis, BSD licence) —
#   sudo apt install valkey   (or the official Docker image valkey/valkey)
# Redis itself works too: same protocol, same REDIS_URL. When set, rate-limit counters live there
# (faster than Postgres, shared by every API process and server). Unset = counters stay in Postgres.
# If it goes down the API falls back to Postgres.
# REDIS_URL="redis://127.0.0.1:6379/0"
# Rate-limit counters: "redis" (default when REDIS_URL is set), "db" (default otherwise) or "memory".
# RATE_LIMIT_STORE=db

# ── Read-replica (optional) ─────────────────────────────────────────────────────
# A streaming replica of the main database. When set, the heavy read-only screens (reports, search,
# Work Desk queues, audit logs, Excel exports) read from it; every write and everything else stays on
# DATABASE_URL. A replica can lag a moment behind, which these screens tolerate.
# CONNECTIONS: each API process opens a pool on DATABASE_URL AND one on the replica — set
# `&connection_limit=…` on BOTH so (API_WORKERS × limit) stays under each server's max_connections.
# DATABASE_REPLICA_URL="postgresql://omr_ro:CHANGE_ME@10.0.0.12:5432/omr_damuon?schema=public&connection_limit=10"
# Every public origin the browser loads the panel from (comma-separated, no trailing slash).
# For a single-domain setup this is your panel domain; add every tenant/white-label domain too.
CORS_ORIGINS="https://panel.damuon.com"

# ── Web build (read by deploy/deploy.sh when building the Next.js app) ─────────
# PUBLIC_API_BASE is baked into the web bundle at build time (NEXT_PUBLIC_API_BASE). It MUST be the
# SAME public domain the browser loads the panel from, with the /api/v1 path — otherwise the web
# calls the wrong host and every API request fails. Set it to THIS server's real domain (do NOT
# leave the placeholder). deploy.sh reads it from here, so the script never needs editing.
PUBLIC_API_BASE="https://CHANGE-ME.example.com/api/v1"
# Default organization slug the panel assumes when none is in the URL/subdomain (optional).
PUBLIC_TENANT_SLUG="damuon"

# ── Crypto ── CRITICAL: set ONCE, back up, NEVER change after real data exists ─
# Changing FIELD_ENCRYPTION_KEY makes all encrypted PII unreadable.
# Changing BLIND_INDEX_PEPPER breaks every National-ID / phone lookup.
# Generate on the server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64"
FIELD_ENCRYPTION_KEY_VERSION="1"
BLIND_INDEX_PEPPER="REPLACE_WITH_32_BYTE_BASE64"

# ── Auth ──────────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="REPLACE_WITH_48_BYTE_BASE64"
JWT_SESSION_TTL="8h"
RECORD_TOKEN_TTL="10m"

# ── OTP / rate limits ────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
RL_OTP_ISSUE_PER_IP_PER_HOUR=10
RL_OTP_ISSUE_PER_NID_PER_HOUR=5
RL_INQUIRY_PER_IP_PER_MIN=20

# ── SMS gateway ── one provider per deployment; switch off `console` for production ────────────
# Supported SMS_DRIVER values: console | magfa | kavenegar | ghasedak | smsir | melipayamak
#   (add more by dropping a file in apps/api/src/modules/auth/sms/drivers + one line in sms.service.ts)
#
# Fill ONLY the fields your chosen provider needs:
#   magfa        -> SMS_USERNAME, SMS_PASSWORD, SMS_DOMAIN, SMS_SENDER        (Damuon uses this)
#   kavenegar    -> SMS_API_KEY, SMS_SENDER [, SMS_OTP_PATTERN]
#   ghasedak     -> SMS_API_KEY, SMS_SENDER [, SMS_OTP_PATTERN]
#   smsir        -> SMS_API_KEY, SMS_SENDER [, SMS_OTP_TEMPLATE_ID]
#   melipayamak  -> SMS_USERNAME, SMS_PASSWORD, SMS_SENDER [, SMS_OTP_PATTERN=<bodyId>]
#
# OTP in Iran usually must use a provider-approved pattern/template. Set the pattern field below and
# the system uses the provider's verify endpoint for OTP; leave it blank to fall back to free text.
SMS_DRIVER="magfa"
SMS_SENDER="REPLACE_WITH_YOUR_LINE_NUMBER"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_PASSWORD=""
SMS_DOMAIN=""
SMS_OTP_PATTERN=""
SMS_OTP_TEMPLATE_ID=""

# ── File storage (encrypted at rest) ──────────────────────────────────────────
# Absolute path on a persistent, backed-up disk. Must be writable by the omr user.
STORAGE_DIR="/var/lib/omr/storage"

# ── OCR ── keep stubbed for the non-OCR pilot ─────────────────────────────────
OCR_DRIVER="stub"
