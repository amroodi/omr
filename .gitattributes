# Normalize line endings. Unix-targeted files must stay LF or they break on the server
# (a CRLF shebang or systemd unit fails to execute/parse on Linux).
* text=auto eol=lf

*.sh            text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
*.conf.example  text eol=lf
*.env.example   text eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
