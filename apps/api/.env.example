# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omr_damuon?schema=public"

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated allowlist of tenant origins for CORS
CORS_ORIGINS="http://localhost:3000"

# ── Crypto (generate real values; NEVER commit real secrets) ───────────────
# 32 bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY="REPLACE_ME_32_BYTE_BASE64_KEY"
# Current key version label (for rotation)
FIELD_ENCRYPTION_KEY_VERSION="1"
# Pepper for blind-index HMAC (separate secret): randomBytes(32).toString('base64')
BLIND_INDEX_PEPPER="REPLACE_ME_BLIND_INDEX_PEPPER"

# ── Auth ──────────────────────────────────────────────────────────────────
# randomBytes(48).toString('base64')
JWT_SECRET="REPLACE_ME_JWT_SECRET"
JWT_SESSION_TTL="8h"
# Short-lived, single-record token issued after OTP for the public inquiry
RECORD_TOKEN_TTL="10m"

# ── OTP / inquiry gating ───────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
# Rate limits
RL_OTP_ISSUE_PER_IP_PER_HOUR=10
RL_OTP_ISSUE_PER_NID_PER_HOUR=5
RL_INQUIRY_PER_IP_PER_MIN=20

# ── SMS gateway (dev driver logs to console) ───────────────────────────────
# console | magfa | kavenegar | ghasedak | smsir | melipayamak
SMS_DRIVER="console"
SMS_SENDER=""
SMS_API_KEY=""       # kavenegar / ghasedak / smsir
SMS_USERNAME=""      # magfa / melipayamak
SMS_PASSWORD=""      # magfa / melipayamak
SMS_DOMAIN=""        # magfa
SMS_OTP_PATTERN=""   # approved OTP template name (kavenegar/ghasedak) or bodyId (melipayamak)
SMS_OTP_TEMPLATE_ID=""  # approved OTP template id (smsir)

# ── File storage (encrypted at rest) & OCR ─────────────────────────────────
# Private directory for uploaded documents (NOT served statically). Swap for object storage in prod.
STORAGE_DIR=".storage"
# OCR engine: stub (default, returns empty) | tesseract | <cloud>
OCR_DRIVER="stub"
