// Prisma schema — OMR Damuon multi-tenant insurance platform
// See docs/DATA-DICTIONARY.md for the legacy-field -> model mapping.
//
// Conventions:
// - Every tenant-owned model has `tenantId` and a composite index on it.
// - Fields marked "ENCRYPTED" hold AES-256-GCM ciphertext (see FieldCryptoService),
//   not plaintext. Searchable encrypted fields have a paired `*Hash` blind index.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Tenancy ───────────────────────────────

// An organization's role in the claims ecosystem.
enum TenantKind {
  INSURER // بیمه‌گر — owns policies and the approval hierarchy
  BROKER // کارگزاری — acts as معرف, introduces claims to insurers
}

model Tenant {
  id            String     @id @default(uuid())
  kind          TenantKind @default(BROKER)
  slug          String     @unique // subdomain / white-label key
  name          String
  logoUrl       String?
  faviconUrl    String?
  logoKey       String? // storage key of uploaded logo (encrypted at rest)
  faviconKey    String? // storage key of uploaded favicon
  fontKey       String? // storage key of uploaded custom font (.woff2/.ttf)
  primaryColor  String   @default("#ff9500")
  contactHeader String? // injected into exported PDF/Excel headers
  carrierConfig String? // ENCRYPTED json: upstream carrier credentials
  smsConfig     String? // ENCRYPTED json: this org's SMS provider + credentials (per-tenant gateway)
  smsUsePlatform          Boolean @default(false) // approved to send via the host platform gateway
  smsUsePlatformRequested Boolean @default(false) // org asked to use the platform gateway (awaits super-admin)
  fontFamily    String?  @default("Vazirmatn")
  noticeDays    Int      @default(30) // deadline (days from event) for the بیمه‌گزار to report
  // Origins allowed to embed the inquiry widget in an <iframe> (CSP frame-ancestors allowlist).
  embedOrigins  String[] @default([])
  isActive      Boolean  @default(true)
  licenseUntil  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branches   Branch[]
  orgUsers   OrgUser[]
  roles      Role[]
  insured    InsuredParty[]
  policies   Policy[]
  cases      Case[]
  documents  Document[]
  auditLogs  AuditLog[]
  otpChallenges OtpChallenge[]
  customers  CustomerAccount[]
  sharesOwned    DataSharingAgreement[] @relation("ShareOwner")
  sharesReceived DataSharingAgreement[] @relation("SharePartner")
  approvalLevels ApprovalLevel[]
  requiredDocuments RequiredDocument[]
  claimFieldDefs ClaimFieldDef[]
  apiKeys    ApiKey[]
}

// Scoped, rotatable API key for server-to-server integration from a customer's own backend.
// Only a SHA-256 hash of the secret is stored; the plaintext is shown once at creation.
// `prefix` is a public lookup id embedded at the start of the key.
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  prefix      String    @unique // public lookup id, e.g. "omr_live_a1b2c3d4"
  keyHash     String // sha256 of the full key
  scopes      String[]  @default([]) // e.g. ["claim:status"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// Host/platform singleton settings (super-admin managed). The platform SMS gateway (Damuon's Magfa
// today) sends pre-signup OTPs and serves organizations approved to use the platform gateway.
model PlatformConfig {
  id        String   @id @default("platform")
  smsConfig String? // ENCRYPTED json: the platform SMS provider + credentials
  updatedAt DateTime @updatedAt @default(now())
}

// Who a notification is for: ORG = the organization's staff (tenant-wide inbox);
// CUSTOMER = one بیمه‌گزار account (recipientId). Each notification is also sent by SMS.
enum NotificationAudience {
  ORG
  CUSTOMER
}

model Notification {
  id          String               @id @default(uuid())
  tenantId    String
  audience    NotificationAudience
  recipientId String? // CustomerAccount id for CUSTOMER; null = whole-org inbox for ORG
  title       String
  body        String
  link        String? // in-panel path the recipient should open
  readAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([tenantId, audience, recipientId, readAt])
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String
  createdAt DateTime @default(now())

  orgUsers OrgUser[]
  cases    Case[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ─────────────────────────── Identity & access ──────────────────────────

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String // argon2id
  totpSecret   String? // ENCRYPTED
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  permissions String[] // e.g. ["case:read","case:edit","export:pii"]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  orgUsers OrgUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model OrgUser {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  username     String
  displayName  String
  passwordHash String // argon2id
  totpSecret   String? // ENCRYPTED, optional MFA
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([tenantId, username])
  @@index([tenantId])
}

// Customer (end-user) login identity — the "customer realm". Distinct from OrgUser. A customer
// authenticates with National ID + phone + OTP and sees only their own linked cases (matched by
// nationalCodeHash against insured or beneficiary). Scoped to one tenant.
// A بیمه‌گزار account's lifecycle. Admin-created accounts are ACTIVE immediately; self-signups are
// PENDING until an org admin approves (then ACTIVE) or rejects (REJECTED). Only ACTIVE can log in.
enum CustomerSignupStatus {
  PENDING
  ACTIVE
  REJECTED
}

model CustomerAccount {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  branchId         String? // registered-at branch
  nationalCode     String // ENCRYPTED
  nationalCodeHash String // blind index / login key
  fullName         String? // ENCRYPTED
  phone            String? // ENCRYPTED
  phoneHash        String? // blind index for OTP pairing
  shareConsent     Boolean  @default(false) // consent to FULL cross-org sharing of their PII
  signupStatus     CustomerSignupStatus @default(ACTIVE)
  isActive         Boolean  @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())

  @@unique([tenantId, nationalCodeHash])
  @@index([tenantId, phoneHash])
}

// ─────────────────────────── Insurance domain ───────────────────────────

model InsuredParty {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  nationalCode     String // ENCRYPTED
  nationalCodeHash String // blind index (HMAC) — used for lookup, replaces IDOR key
  fullName         String // ENCRYPTED
  fatherName       String? // ENCRYPTED
  birthDate        DateTime?
  dateOfDeath      DateTime? // tarikh_fot
  deathReportedAt  DateTime? // tarikh_elam_fot
  phone            String? // ENCRYPTED
  phoneHash        String? // blind index for OTP pairing
  address          String? // ENCRYPTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  policies      Policy[]
  cases         Case[]
  beneficiaries Beneficiary[]

  @@unique([tenantId, nationalCodeHash])
  @@index([tenantId, phoneHash])
}

enum BeneficiaryType {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  OTHER
}

model Beneficiary {
  id             String          @id @default(uuid())
  tenantId       String
  insuredId      String
  insured        InsuredParty    @relation(fields: [insuredId], references: [id])
  type           BeneficiaryType @default(OTHER)
  nationalCode   String? // ENCRYPTED
  nationalCodeHash String?
  fullName       String // ENCRYPTED
  relationship   String?
  sharePercent   Decimal?        @db.Decimal(5, 2)
  iban           String? // ENCRYPTED
  createdAt      DateTime        @default(now())

  cases Case[]

  @@index([tenantId, insuredId])
}

enum PolicyStatus {
  ACTIVE
  INACTIVE
}

model Policy {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  insuredId    String
  insured      InsuredParty @relation(fields: [insuredId], references: [id])
  policyNumber String
  carrier      String // e.g. "البرز"
  productType  String? // life / death coverage
  startDate    DateTime? // tarikh_bime
  sumInsured   Decimal?     @db.Decimal(18, 2)
  status       PolicyStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  cases Case[]

  @@unique([tenantId, policyNumber])
  @@index([tenantId, insuredId])
}

// Case status mirrors legacy #vaziat_parvandeh badge states.
enum CaseStatus {
  PAID // پرداخت شده
  REVIEWING // در حال بررسی
  UNPAYABLE // غیرقابل پرداخت
  OTHER
}

model Case {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  caseNumber     String
  branchId       String? // owning branch (for branch-scoped access)
  branch         Branch?      @relation(fields: [branchId], references: [id])
  insuredId      String
  insured        InsuredParty @relation(fields: [insuredId], references: [id])
  policyId       String?
  policy         Policy?      @relation(fields: [policyId], references: [id])
  beneficiaryId  String?
  beneficiary    Beneficiary? @relation(fields: [beneficiaryId], references: [id])
  status         CaseStatus   @default(REVIEWING)

  // Workflow dates (legacy *_date fields) — see DATA-DICTIONARY.md
  stageDate               DateTime? // marhale_parvandeh_date
  brokerageNotifiedAt     DateTime? // elam_kargozari_date
  branchNotifiedAt        DateTime? // elam_kargozari_shobe_date
  docsRequestedAt         DateTime? // darkhast_madarek_date
  missingDocsRequestedAt  DateTime? // darkhast_kasri_madarek_date
  docsSentAt              DateTime? // ersal_madarek_date
  deficiencyCompletedAt   DateTime? // takmil_naghs_date
  sentToHqAt              DateTime? // ersal_setad_date
  approvedAt              DateTime? // taeed_parvandeh_date
  returnedToBranchAt      DateTime? // bargasht_shobe_date
  paidAt                  DateTime? // pardakht_date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]
  documents Document[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, insuredId])
}

enum PaymentStatus {
  PAID // success
  PENDING
}

// Maker-checker (four-eyes) state for a payout.
enum PaymentApproval {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  caseId      String
  case        Case          @relation(fields: [caseId], references: [id])
  date        DateTime
  description String?
  amount      Decimal       @db.Decimal(18, 2)
  status      PaymentStatus @default(PENDING)

  // Maker-checker: a payout proposed by one user must be approved by another.
  approval     PaymentApproval @default(PENDING_APPROVAL)
  proposedById String? // OrgUser who created the payout (maker)
  approvedById String? // OrgUser who approved/rejected (checker)
  decidedAt    DateTime?
  approvalNote String?

  createdAt DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([tenantId, approval])
}

// ─────────────────────────── Documents & OCR ────────────────────────────

enum DocumentKind {
  NATIONAL_ID_SCAN
  POLICY_SCAN
  DEATH_CERTIFICATE
  BANK_INFO
  OTHER
}

// Assessment of a document's authenticity/integrity by an "ارزیاب اصالت مدارک" (assessor).
enum VerificationStatus {
  PENDING // awaiting assessment
  VERIFIED // authentic & accurate
  REJECTED // forged / inaccurate / illegible
  NEEDS_INFO // more information required
}

model Document {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  caseId     String?
  case       Case?        @relation(fields: [caseId], references: [id])
  claimId    String? // death-claim this document belongs to (claims workflow)
  docCode    String? // RequiredDocument.code this upload satisfies (claims)
  kind       DocumentKind @default(OTHER)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String // private object-storage key
  ocrStatus  String       @default("pending") // pending|processing|done|failed
  ocrText    String? // ENCRYPTED — may contain PII
  ocrFields  String? // ENCRYPTED json — auto-populated values
  uploadedBy String?

  // Document-authenticity assessment
  verificationStatus VerificationStatus @default(PENDING)
  verifiedById       String? // OrgUser id of the assessor
  verifiedAt         DateTime?
  verificationNote   String? // reason / findings

  createdAt DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([tenantId, verificationStatus])
}

// ───────────────────────── OTP (inquiry gating) ─────────────────────────

model OtpChallenge {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  purpose      String   @default("inquiry") // "inquiry" (one case) | "customer" (login)
  phoneHash    String // blind index of the target phone
  insuredId    String?
  caseId       String? // record this challenge unlocks (inquiry purpose)
  codeHash     String // salted hash of the OTP, never plaintext
  attempts     Int      @default(0)
  maxAttempts  Int      @default(5)
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([tenantId, phoneHash])
  @@index([expiresAt])
}

// ─────────────────────── Cross-org data sharing ─────────────────────────

enum SharingScope {
  CASE_STATUS // read-only status/workflow, no PII
  FULL // read all owned data (still subject to the partner's own RBAC + customer consent)
}

// An explicit, revocable grant letting one tenant (partner) read another tenant's (owner) data.
// Never wired into the default query scope — partners read only via "shared with me" endpoints
// that call SharingService.assertAccess first. Isolation stays the safe default.
model DataSharingAgreement {
  id             String       @id @default(uuid())
  ownerTenantId  String
  ownerTenant    Tenant       @relation("ShareOwner", fields: [ownerTenantId], references: [id])
  partnerTenantId String
  partnerTenant  Tenant       @relation("SharePartner", fields: [partnerTenantId], references: [id])
  scope          SharingScope @default(CASE_STATUS)
  isActive       Boolean      @default(true)
  note           String?
  createdBy      String? // super-admin or org user id
  revokedAt      DateTime?
  revokedBy      String?
  createdAt      DateTime     @default(now())

  @@unique([ownerTenantId, partnerTenantId, scope])
  @@index([partnerTenantId, isActive])
}

// ─────────────────── Configurable claim fields + OCR provenance ─────────
// The claim data/workflow fields operators fill. Configurable per insurer and per party
// (authority), OCR-assisted: values carry provenance + confidence and need human confirmation.

enum FieldType {
  TEXT
  NUMBER
  AMOUNT
  DATE // Jalali date stored ISO
  SELECT
  BOOL
  NATIONAL_CODE // Iranian کد ملی (checksum-validated)
  IBAN // Iranian شبا (checksum-validated)
}

enum FieldGroup {
  CLAIM_DATA // بیمه‌شده/بیمه‌نامه/سرمایه
  BENEFICIARY // ذینفع
  WORKFLOW_STAGE // مراحل و وضعیت‌های گردش کار
}

enum FieldSource {
  MANUAL // typed by a human
  OCR // extracted by OCR, not yet confirmed
  OCR_CORRECTED // OCR value edited by a human
}

model ClaimFieldDef {
  id         String         @id @default(uuid())
  tenantId   String // INSURER
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  key        String // stable, e.g. "payable_amount"
  label      String
  type       FieldType      @default(TEXT)
  group      FieldGroup     @default(CLAIM_DATA)
  options    String[] // for SELECT
  editableBy ClaimPartyType[] // which parties (authority) may fill this field
  order      Int            @default(0)
  required   Boolean        @default(false)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ClaimFieldValue {
  id            String      @id @default(uuid())
  claimId       String
  claim         Claim       @relation(fields: [claimId], references: [id])
  key           String
  value         String? // typed per the field def; stored as string
  source        FieldSource @default(MANUAL)
  confidence    Float? // OCR confidence 0..1
  sourceDocId   String? // document the OCR value came from
  confirmedById String? // human who confirmed (null = unconfirmed OCR draft)
  confirmedAt   DateTime?
  updatedById   String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([claimId, key])
  @@index([claimId])
}

// ─────────────────────── Claims workflow (hierarchy) ────────────────────
// See docs/CLAIMS-WORKFLOW.md. A Claim is a CROSS-TENANT object: it is not auto-scoped by the
// Prisma tenant extension (it has no single `tenantId`). Access is granted per party via
// ClaimParticipant (orgs) and the policyHolderId (the filing بیمه‌گزار).

enum SalesChannel {
  DIRECT // bought from the insurer; معرف = the selling insurer branch
  BROKER // bought through a brokerage; معرف = the broker tenant
}

// Claim scenarios from the policy contract (clause ج). A claim is one of these.
enum ClaimType {
  DEATH_ILLNESS // ج-۱ فوت ناشی از بیماری (طبیعی)
  DEATH_ACCIDENT // ج-۲ فوت ناشی از حادثه
  DISABILITY_ACCIDENT // ج-۴ نقص عضو / ازکارافتادگی ناشی از حادثه
}

// Per-insurer configurable catalog of required claim documents. Each document applies to one or
// more claim types. The business list is edited here (or via the API) with no code change.
model RequiredDocument {
  id             String      @id @default(uuid())
  tenantId       String // the INSURER
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  code           String // stable key, e.g. "death_cert_cause"
  label          String // Persian label
  appliesToTypes ClaimType[] // which claim scenarios require this document
  order          Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum ApprovalLevelKind {
  INSURER_CLAIMS // بیمه‌گر (واحد خسارت)
  TECHNICAL_MGMT // مدیریت فنی مربوطه
  COUNCIL_DEPUTY // معاون شورای فنی (gateway)
  TECHNICAL_COUNCIL // شورای فنی (final)
  CUSTOM
}

// Per-insurer configurable approval ladder. `ceiling` null = unlimited (top of chain).
model ApprovalLevel {
  id        String            @id @default(uuid())
  tenantId  String // the INSURER (auto-scoped for insurer admins)
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  name      String
  order     Int // 1 = first authority level (بیمه‌گر)
  ceiling   Decimal?          @db.Decimal(18, 2)
  kind      ApprovalLevelKind @default(CUSTOM)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@unique([tenantId, order])
  @@index([tenantId])
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED_INCOMPLETE // نقص مدارک — with بیمه‌گزار for رفع نقص
  APPROVED
  REJECTED
  PAID
}

model Claim {
  id          String       @id @default(uuid())
  claimNumber String       @unique

  // Parties (cross-tenant; plain id references, not relations)
  insurerTenantId String // بیمه‌گر — owns the claim
  channel         SalesChannel
  brokerTenantId  String? // معرف (BROKER channel)
  sellingBranchId String? // معرف = insurer branch that sold (DIRECT channel)
  policyHolderId  String? // بیمه‌گزار (CustomerAccount) who files & does رفع نقص

  // Subject (deceased بیمه‌شده / متوفی)
  deceasedFullName         String // ENCRYPTED
  deceasedNationalCode     String // ENCRYPTED
  deceasedNationalCodeHash String // blind index
  claimType                ClaimType @default(DEATH_ILLNESS)
  eventDate                DateTime? // date of death/accident (the risk event)
  noticeDeadline           DateTime? // eventDate + insurer.noticeDays (snapshot)
  lateNotice               Boolean   @default(false) // filed after the deadline
  policyNumber             String?
  claimedAmount            Decimal @db.Decimal(18, 2)

  status    ClaimStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  steps        ClaimStep[]
  participants ClaimParticipant[]
  deficiencies ClaimDeficiency[]
  fieldValues  ClaimFieldValue[]

  @@index([insurerTenantId, status])
  @@index([brokerTenantId])
  @@index([deceasedNationalCodeHash])
}

enum ClaimPartyType {
  POLICYHOLDER // بیمه‌گزار
  MOAREF // معرف (broker or selling branch)
  INSURER_LEVEL // an insurer ApprovalLevel
}

enum ClaimStepState {
  PENDING // awaiting the holder's action
  FORWARDED // control passed to the next party (معرف → بیمه‌گر)
  ESCALATED // amount exceeded ceiling → next level up
  APPROVED // authorized at this level
  RETURNED_INCOMPLETE // نقص مدارک raised here
  REJECTED // substantive rejection
  ACKED // decision cascaded through this step on the way down
}

model ClaimStep {
  id             String         @id @default(uuid())
  claimId        String
  claim          Claim          @relation(fields: [claimId], references: [id])
  order          Int
  partyType      ClaimPartyType
  levelId        String? // ApprovalLevel id when partyType = INSURER_LEVEL
  holderTenantId String // org that holds this step
  holderBranchId String? // specific branch (معرف in DIRECT channel)
  direction      String         @default("UP") // UP (toward authority) | DOWN (decision cascade)
  state          ClaimStepState @default(PENDING)
  note           String?
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([claimId, order])
  @@index([holderTenantId, state])
}

// Which organizations may access a claim (the filing بیمه‌گزار is matched via policyHolderId).
model ClaimParticipant {
  id        String   @id @default(uuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id])
  tenantId  String // participating org
  role      String // INSURER | MOAREF_BROKER | MOAREF_BRANCH
  createdAt DateTime @default(now())

  @@unique([claimId, tenantId])
  @@index([tenantId])
}

model ClaimDeficiency {
  id              String    @id @default(uuid())
  claimId         String
  claim           Claim     @relation(fields: [claimId], references: [id])
  raisedByTenantId String?
  raisedByStepId  String?
  items           String // JSON array of deficiency descriptions
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([claimId])
}

// ─────────────────────────── Audit (hash chain) ─────────────────────────

enum AuditAction {
  VIEW
  EXPORT
  EDIT
  CREATE
  UPLOAD
  DELETE
  LOGIN
  LOGIN_FAILED
  OTP_ISSUE
  OTP_VERIFY
  TENANT_PROVISION
  SHARE_GRANT
  SHARE_REVOKE
  PAYMENT_PROPOSE
  PAYMENT_APPROVE
  PAYMENT_REJECT
  CLAIM_SUBMIT
  CLAIM_FORWARD
  CLAIM_ESCALATE
  CLAIM_APPROVE
  CLAIM_RETURN_INCOMPLETE
  CLAIM_RECTIFY
  CLAIM_REJECT
  CLAIM_PAY
}

model AuditLog {
  id             String      @id @default(uuid())
  tenantId       String?
  tenant         Tenant?     @relation(fields: [tenantId], references: [id])
  actorType      String // ORG_USER | SUPER_ADMIN | INSURED | SYSTEM
  actorId        String?
  action         AuditAction
  targetType     String?
  targetId       String?
  ip             String?
  userAgent      String?
  metadata       String? // json, PII-redacted
  jalaliTimestamp String // rendered Shamsi time
  prevHash       String?
  hash           String // SHA256(prevHash + canonical(row)) — tamper evidence
  createdAt      DateTime    @default(now())

  @@index([tenantId, action])
  @@index([tenantId, createdAt])
}
